# Local API server
API_HOST=127.0.0.1
API_PORT=4174
APP_ORIGIN=http://127.0.0.1:5173
SESSION_DAYS=7
AUTH_COOKIE_SECURE=false

# Optional PostgreSQL persistence through Supabase PostgREST.
# Leave blank for local demo storage. Use server-side values only; do not expose these as VITE_* variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-key

# Used only by `npm run admin:create`; never commit real values.
ADMIN_NAME=CyberOps Admin
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password
